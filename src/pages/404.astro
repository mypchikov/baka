---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 • @murchikov">
  <div class="flex min-h-screen items-center justify-center gap-12 px-6">
    <img src="/static/404.png" alt="404 not found" width="400" height="400" />
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-3">
        <p class="text-xl text-gray-300">Кажется, запрашиваемая страница не найдена</p>
        <p class="text-sm text-gray-500">Проверьте введенный URL или вернитесь на главную</p>
      </div>
    </div>
  </div>
</BaseLayout>